---
import '@fontsource-variable/manrope';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import { getContent, otherLocalePath } from '../content/schema';
import { RESPECT_REDUCED_MOTION } from '../motion/prefers';
import EmailMenu from '../components/layout/EmailMenu.astro';
import site from '../data/site.json';
const content = getContent(Astro.currentLocale);
interface Props {
  title?: string;
  description?: string;
  /** Link-preview image under public/ (1200×630). */
  image?: string;
  /** Page name for anonymous view counts (the card counts its own views). */
  track?: 'pro' | 'life';
}
const {
  title = content.meta.title,
  description = content.meta.description,
  image: imageProp = '/og/pro.png',
  track,
} = Astro.props;
const locale = Astro.currentLocale === 'es' ? 'es' : 'en';
// Spanish pages get Spanish link previews (og/pro-es.png etc.).
const image = locale === 'es' ? imageProp.replace(/\.png$/, '-es.png') : imageProp;
const enPath = locale === 'es' ? otherLocalePath(Astro.url.pathname, 'es') : Astro.url.pathname;
const esPath = otherLocalePath(enPath, 'en');
const pageUrl = new URL(Astro.url.pathname, 'https://rarmas.cl');
const imageUrl = new URL(image, 'https://rarmas.cl');
// Structured data so search engines understand who this site is about.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Rodolfo Armas Saenz',
  alternateName: site.identity.name,
  url: 'https://rarmas.cl/',
  image: new URL('/og/card.png', 'https://rarmas.cl').href,
  email: `mailto:${site.identity.email}`,
  jobTitle: content.card.role,
  worksFor: { '@type': 'Organization', name: 'Uber Eats' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Pontificia Universidad Católica de Chile' },
  address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' },
  knowsAbout: ['Strategy', 'Planning', 'Forecasting', 'Agentic AI', 'Robotics', 'Industrial Engineering'],
  sameAs: [site.links.linkedin, site.links.instagram, site.links.github],
};
---

<!doctype html>
<html lang={locale === 'es' ? 'es-CL' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, 'https://rarmas.cl')} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, 'https://rarmas.cl')} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, 'https://rarmas.cl')} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CL' : 'en_US'} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rodo Armas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <title>{title}</title>
    <script is:inline define:vars={{ respectReduced: RESPECT_REDUCED_MOTION }}>
      (function () {
        const d = document.documentElement;
        d.classList.add('js-motion');
        if (respectReduced && window.matchMedia('(prefers-reduced-motion: reduce)').matches)
          d.classList.add('reduced-motion');
        setTimeout(function () {
          if (!d.classList.contains('motion-ready')) d.classList.remove('js-motion');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {content.ui.skip}
    </a>
    <slot />
    <EmailMenu />
    {track && <span hidden data-track-page={track}></span>}
    <script>
      import '../motion/index';
      import { track } from '../scripts/track';
      const page = document.querySelector<HTMLElement>('[data-track-page]')?.dataset.trackPage;
      if (page === 'pro' || page === 'life') track('view', { page, source: 'direct' });
    </script>
  </body>
</html>
