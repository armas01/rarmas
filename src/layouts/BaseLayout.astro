---
import '@fontsource-variable/manrope';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import { content } from '../content/schema';
import { RESPECT_REDUCED_MOTION } from '../motion/prefers';
interface Props {
  title?: string;
  description?: string;
  /** Link-preview image under public/ (1200×630). */
  image?: string;
}
const {
  title = content.meta.title,
  description = content.meta.description,
  image = '/og/pro.png',
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, 'https://rarmas.cl');
const imageUrl = new URL(image, 'https://rarmas.cl');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rodo Armas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script is:inline define:vars={{ respectReduced: RESPECT_REDUCED_MOTION }}>
      (function () {
        const d = document.documentElement;
        d.classList.add('js-motion');
        if (respectReduced && window.matchMedia('(prefers-reduced-motion: reduce)').matches)
          d.classList.add('reduced-motion');
        setTimeout(function () {
          if (!d.classList.contains('motion-ready')) d.classList.remove('js-motion');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <script>
      import '../motion/index';
    </script>
  </body>
</html>
