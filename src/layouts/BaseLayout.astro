---
import '@fontsource-variable/manrope';
import '../styles/global.css';
const { title = 'Rodo Armas — Strategy & Planning', description = 'Rodo Armas works in strategy and enjoys building useful software and robotics projects.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname, 'https://rarmas.cl')}/><link rel="icon" type="image/png" href="/favicon.png"/><title>{title}</title></head><body><a class="skip-link" href="#main">Skip to content</a><slot /></body></html>
