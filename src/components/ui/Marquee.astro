---
interface Props {
  items: string[];
  reverse?: boolean;
}
const { items, reverse = false } = Astro.props;
---

<div class="marquee" data-motion="marquee" data-motion-direction={reverse ? 'reverse' : undefined}>
  <div class="marquee-track" data-track>
    <ul>
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <ul aria-hidden="true">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  ul {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: inline-flex;
    align-items: center;
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--muted);
  }
  li::after {
    content: '';
    width: 8px;
    height: 8px;
    margin-inline: clamp(20px, 3vw, 40px);
    border-radius: 50%;
    background: var(--accent-gradient);
  }
</style>
