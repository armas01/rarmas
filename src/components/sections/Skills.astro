---
import Section from '../layout/Section.astro';
import Marquee from '../ui/Marquee.astro';
import { content } from '../../content/schema';

const { skills } = content;
---

<Section id="skills" labelledby="skills-title">
  <div class="shell">
    <p class="eyebrow">{skills.eyebrow}</p>
    <h2 id="skills-title" class="h2 skills-title" data-motion="reveal-words">
      {skills.title}
    </h2>
  </div>
  <div class="rows">
    <div class="row row-solid">
      <Marquee items={skills.rows[0]} />
    </div>
    <div class="row row-outline">
      <Marquee items={skills.rows[1]} reverse />
    </div>
  </div>
  <div class="shell">
    <ul class="interests" data-motion="reveal-up" data-motion-stagger="0.08">
      {skills.interests.map((it, i) => (
        <li class="interest" data-motion="tilt">
          <span class="idx">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="i-title">{it.title}</h3>
          <p class="i-body">{it.body}</p>
          <span class="glyph" aria-hidden="true">
            ↗
          </span>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .skills-title {
    margin-top: var(--space-4);
    max-width: 16ch;
    text-wrap: balance;
  }
  .rows {
    margin-top: var(--space-8);
    display: grid;
    /* minmax(0, …) stops the nowrap marquee track from stretching the column (and the page) */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  .row :global(li) {
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--text);
  }
  .row-outline :global(li) {
    -webkit-text-stroke: 1px var(--muted);
    color: transparent;
  }
  .interests {
    margin: var(--space-9) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .interest {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(24px, 3vw, 40px);
    min-height: 260px;
    border-radius: var(--radius-3);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .idx {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .i-title {
    margin-top: auto;
    font-size: clamp(1.375rem, 2.2vw, 1.875rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .i-body {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: 38ch;
  }
  .glyph {
    position: absolute;
    top: clamp(20px, 2.4vw, 32px);
    right: clamp(20px, 2.4vw, 32px);
    font-size: 1.5rem;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (max-width: 899px) {
    .interests {
      grid-template-columns: 1fr;
    }
    .interest {
      min-height: 200px;
    }
  }
</style>
