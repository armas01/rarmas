---
import { readFile } from 'node:fs/promises';
import Section from '../layout/Section.astro';
import Button from '../ui/Button.astro';
import { content } from '../../content/schema';
import { selectPosts } from '../../content/posts';
import fallbackPosts from '../../data/linkedin.json';
import site from '../../data/site.json';

const { writing } = content;
let generated: unknown = undefined;
try {
  generated = JSON.parse(await readFile(new URL('../../generated/linkedin.json', import.meta.url), 'utf8'));
} catch {}
const posts = selectPosts(generated, fallbackPosts, writing.placeholders);
---

<Section id="writing" theme="light" labelledby="writing-title">
  <div class="shell">
    <div class="head">
      <div>
        <p class="eyebrow">{writing.eyebrow}</p>
        <h2 id="writing-title" class="h2 writing-title" data-motion="reveal-words">
          {writing.title}
        </h2>
      </div>
      <Button href={site.links.linkedin} variant="ghost" external>
        {writing.cta}
      </Button>
    </div>
    <div class="posts" data-motion="reveal-up" data-motion-stagger="0.08">
      {posts.map((p) => (
        <a
          class="post"
          href={p.href}
          target={p.external ? '_blank' : undefined}
          rel={p.external ? 'noreferrer' : undefined}
        >
          <p class="date">{p.date}</p>
          <h3 class="title">{p.title}</h3>
          <span class="read">
            Read <span aria-hidden="true">↗</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</Section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .writing-title {
    margin-top: var(--space-4);
    max-width: 14ch;
    text-wrap: balance;
  }
  .posts {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .post {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 280px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-3);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    transition:
      transform var(--dur-1) var(--ease-out),
      box-shadow var(--dur-1) var(--ease-out);
  }
  .post:hover,
  .post:focus-visible {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px -16px rgb(10 10 11 / 0.22);
  }
  .date {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }
  .read {
    margin-top: auto;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  @media (max-width: 899px) {
    .posts {
      grid-template-columns: 1fr;
    }
    .post {
      min-height: 0;
    }
  }
</style>
