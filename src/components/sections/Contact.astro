---
import Section from '../layout/Section.astro';
import Button from '../ui/Button.astro';
import { content } from '../../content/schema';

const { contact } = content;
---

<Section id="contact" labelledby="contact-title">
  <div class="orb" aria-hidden="true"></div>
  <div class="shell inner">
    <p class="eyebrow">{contact.eyebrow}</p>
    <h2 id="contact-title" class="contact-title" data-motion="reveal-words">
      {contact.headline}
    </h2>
    <div class="cta">
      <Button href={contact.cta.href} variant="light" magnetic>
        {contact.cta.label}
      </Button>
    </div>
  </div>
</Section>

<style>
  :global(#contact) {
    position: relative;
    overflow: hidden;
  }
  .orb {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(90vw, 900px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-a), var(--accent-b) 45%, transparent 70%);
    filter: blur(90px);
    opacity: 0.3;
    pointer-events: none;
  }
  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .contact-title {
    margin-top: var(--space-5);
    font-size: clamp(3rem, 12vw, 10rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    padding-bottom: 0.08em;
    text-wrap: balance;
  }
  .contact-title,
  .contact-title :global(.word) {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  :global(html.js-motion) .contact-title:has(:global(.word)) {
    background: none;
  }
  .cta {
    margin-top: var(--space-8);
  }
</style>
