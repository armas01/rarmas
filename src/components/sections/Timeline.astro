---
import Section from '../layout/Section.astro';
import { getContent } from '../../content/schema';
const content = getContent(Astro.currentLocale);

const { timeline } = content;
---

<Section id="timeline" labelledby="timeline-title">
  <div class="shell">
    <p class="eyebrow">{timeline.eyebrow}</p>
    <h2 id="timeline-title" class="h2 timeline-title" data-motion="reveal-words">
      {timeline.title}
    </h2>
    <ol class="timeline" data-motion="draw-line">
      <span class="line" aria-hidden="true">
        <span data-line-fill></span>
      </span>
      {timeline.entries.map((e) => (
        <li class="entry" data-entry>
          <span class="dot" aria-hidden="true"></span>
          <div class="body">
            <p class="date">{e.date}</p>
            <h3 class="role">{e.role}</h3>
            <p class="org">{e.org}</p>
            <p class="text">{e.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  .timeline-title {
    margin-top: var(--space-4);
    max-width: 16ch;
    text-wrap: balance;
  }
  .timeline {
    position: relative;
    margin: var(--space-9) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-9);
  }
  .line {
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--line);
  }
  .line [data-line-fill] {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent-gradient);
    transform-origin: top;
    transform: scaleY(1);
  }
  :global(html.js-motion) .line [data-line-fill] {
    transform: scaleY(0);
  }
  .entry {
    position: relative;
    padding-left: 48px;
  }
  .dot {
    position: absolute;
    left: 0;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line);
    transition:
      transform var(--dur-1) var(--ease-out),
      background var(--dur-1) var(--ease-out),
      box-shadow var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }
  .entry[data-active] .dot {
    transform: scale(1.5);
    background: var(--accent-a);
    border-color: var(--accent-a);
    box-shadow:
      0 0 0 6px rgb(61 123 255 / 0.18),
      0 0 28px var(--accent-b);
  }
  .date {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .role {
    margin-top: var(--space-2);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .org {
    margin-top: var(--space-1);
    font-weight: 600;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .text {
    margin-top: var(--space-3);
    max-width: 46ch;
    color: var(--muted);
    line-height: 1.55;
  }
  @media (min-width: 900px) {
    .line {
      left: 50%;
      margin-left: -1px;
    }
    .entry {
      width: 50%;
      padding-left: 0;
      padding-right: 56px;
      text-align: right;
    }
    .entry .text,
    .entry .org {
      margin-left: auto;
    }
    .entry .dot {
      left: auto;
      right: -8px;
    }
    .entry:nth-of-type(even) {
      margin-left: 50%;
      padding-right: 0;
      padding-left: 56px;
      text-align: left;
    }
    .entry:nth-of-type(even) .text,
    .entry:nth-of-type(even) .org {
      margin-left: 0;
    }
    .entry:nth-of-type(even) .dot {
      right: auto;
      left: -8px;
    }
  }
</style>
