---
import Section from '../layout/Section.astro';
import { content } from '../../content/schema';

const { about } = content;
const { portrait } = about;
---

<Section id="about" labelledby="about-title">
  <div class="shell grid">
    <figure class="portrait" data-motion="reveal-up">
      {portrait.src ? (
        <img src={portrait.src} alt={portrait.alt} width="480" height="600" loading="lazy" decoding="async" />
      ) : (
        <div class="placeholder" role="img" aria-label={`${portrait.alt} (coming soon)`}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="8.5" r="4" />
            <path d="M4 21c1.2-4.2 4.3-6.5 8-6.5s6.8 2.3 8 6.5" />
          </svg>
          <span>Photo coming soon</span>
        </div>
      )}
    </figure>
    <div>
      <h2 id="about-title" class="eyebrow">
        {about.eyebrow}
      </h2>
      <p class="about-body" data-motion="scrub-words">
        {about.body}
      </p>
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(220px, 360px) 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .portrait {
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-3);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-3);
    width: 100%;
    height: 100%;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background:
      radial-gradient(120% 80% at 20% 0%, rgb(120 140 255 / 0.22), transparent 60%),
      radial-gradient(100% 70% at 100% 100%, rgb(170 110 255 / 0.18), transparent 60%);
  }
  .placeholder svg {
    width: 72px;
    height: 72px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
  }
  .about-body {
    margin-top: var(--space-6);
    max-width: 900px;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }
  @media (max-width: 899px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 320px;
    }
  }
</style>
